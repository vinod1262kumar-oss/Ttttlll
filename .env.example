# Supabase browser-safe values.
# Publishable/anon key is okay in the browser when RLS is correctly configured.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Google OAuth is configured in Supabase Auth, not with a Google API secret in this file.
# Server-only key. NEVER put this in public/ or client JavaScript.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Gemini server-only key.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# V1 entitlement. Payments are intentionally disabled until after launch.
FREE_SCANS=8
PORT=3000
SITE_URL=http://localhost:3000
MAX_IMAGE_BYTES=5242880
CONTACT_EMAIL=hello@example.com
